generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  BUSINESS_CUSTOMER
  ADMINISTRATOR
  GUEST
}

enum OrganizationType {
  PERSONAL
  BUSINESS
  CARRIER
  INTERNAL
}

enum Direction {
  IMPORT
  EXPORT
}

enum ServiceType {
  EXPRESS_COURIER
  ECONOMY_COURIER
  ROAD_FREIGHT
}

enum ContentsType {
  DOCUMENTS
  PARCEL
  MULTIPLE_PARCELS
  BOXES
  PALLET
}

enum QuoteStatus {
  PENDING_REVIEW
  QUOTED
  ACCEPTED
  REJECTED
  BOOKED
  CANCELLED
}

enum QuotationStatus {
  DRAFT
  APPROVED
  SENT
  ACCEPTED
  REJECTED
}

enum ShipmentStatus {
  BOOKED
  PICKUP_SCHEDULED
  PICKUP_PENDING
  PICKED_UP
  COLLECTED
  IN_TRANSIT
  ARRIVED_AT_DESTINATION
  CUSTOMS_CLEARANCE
  CUSTOMS_HOLD
  OUT_FOR_DELIVERY
  DELIVERED
  FINANCIALLY_CLOSED
  ON_HOLD
  EXCEPTION
  CANCELLED
  RETURN_IN_PROGRESS
  RETURNED
  LOST
  DAMAGED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

enum ServiceCategory {
  EXPRESS
  ROAD_FREIGHT
  AIR_FREIGHT
  SEA_FREIGHT
}

enum QuoteWorkflowStage {
  QUOTATION
  BOOKING
}

enum WeightUnit {
  KG
  LB
}

enum DimensionUnit {
  CM
  IN
  M
}

enum TariffStatus {
  DRAFT
  VALIDATED
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum SurchargeBasis {
  FIXED
  PERCENTAGE
  PER_KG
  PER_CHARGEABLE_KG
  PER_PIECE
  PER_SHIPMENT
  PER_PALLET
}

enum ImportJobStatus {
  UPLOADED
  PARSED
  MAPPED
  VALIDATED
  IMPORTED
  FAILED
}

enum CalcStatus {
  CALCULATED
  MANUAL_REQUIRED
  OVERRIDDEN
  APPROVED
}

model Organization {
  id        String           @id @default(cuid())
  name      String
  type      OrganizationType @default(PERSONAL)
  createdAt DateTime         @default(now()) @map("created_at")
  users     User[]
  quotes    Quote[]

  @@map("organizations")
}

model User {
  id               String                  @id @default(cuid())
  name             String
  email            String                  @unique
  passwordHash     String                  @map("password_hash")
  role             UserRole                @default(CUSTOMER)
  organizationId   String?                 @map("organization_id")
  organization     Organization?           @relation(fields: [organizationId], references: [id])
  createdAt        DateTime                @default(now()) @map("created_at")
  isActive         Boolean                 @default(true) @map("is_active")
  addresses        Address[]
  quotes           Quote[]
  shipments        Shipment[]
  notifications    Notification[]
  supportTickets   SupportTicket[]
  approvals        AdminQuotation[]        @relation("QuotationApprover")
  pricingProfile   BusinessPricingProfile?
  pricingOverrides PricingOverride[]       @relation("OverrideUser")
  auditLogs        AuditLog[]              @relation("AuditActor")
  invoices         Invoice[]

  // Billing entity details (optional; used on the printable invoice/PDF). Additive & nullable so existing
  // users and invoices keep working — the template falls back to name/email when these are empty.
  billingLegalName   String? @map("billing_legal_name")
  billingTradingName String? @map("billing_trading_name")
  billingTaxId       String? @map("billing_tax_id")
  billingAddress     String? @map("billing_address") @db.Text
  billingCountry     String? @map("billing_country")
  billingPhone       String? @map("billing_phone")

  // Customer Master profile details (additive & nullable; backward-compatible). Customer type = role,
  // status = isActive, legal/trading/NIPT reuse the billing* fields above.
  contactPerson      String? @map("contact_person")
  phone              String?
  billingCity        String? @map("billing_city")
  billingZip         String? @map("billing_zip")

  @@index([role, isActive])
  @@map("users")
}

// Centralized ForwardOne company / billing profile. A single-row (singleton) table so company details on
// invoices are configured in one place, never hardcoded. All fields optional so the app runs with sensible
// defaults before an administrator fills them in.
model CompanyProfile {
  id                String   @id @default("forwardone")
  legalName         String?  @map("legal_name")
  taxId             String?  @map("tax_id")
  registeredAddress String?  @map("registered_address") @db.Text
  phone             String?
  email             String?
  website           String?
  bankName          String?  @map("bank_name")
  bankAccount       String?  @map("bank_account")
  iban              String?
  swift             String?
  currency          String?
  vatNumber         String?  @map("vat_number")
  vatInfo           String?  @map("vat_info") @db.Text
  defaultVatPct     Decimal? @map("default_vat_pct") @db.Decimal(5, 2)
  paymentTermsDays  Int?     @map("payment_terms_days")
  logoUrl           String?  @map("logo_url")
  footerNote        String?  @map("footer_note") @db.Text
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("company_profile")
}

model Address {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label        String
  name         String
  company      String?
  addressLine1 String   @map("address_line1")
  addressLine2 String?  @map("address_line2")
  country      String
  city         String
  state        String?
  zip          String?
  phone        String
  email        String
  kind         String?
  isFavorite   Boolean  @default(false) @map("is_favorite")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([userId, isFavorite])
  @@map("addresses")
}

model Quote {
  id                        String                     @id @default(cuid())
  reference                 String                     @unique
  userId                    String                     @map("user_id")
  user                      User                       @relation(fields: [userId], references: [id])
  organizationId            String?                    @map("organization_id")
  organization              Organization?              @relation(fields: [organizationId], references: [id])
  direction                 Direction
  serviceType               ServiceType                @map("service_type")
  contentsType              ContentsType               @map("contents_type")
  senderJson                Json                       @map("sender_json")
  receiverJson              Json                       @map("receiver_json")
  pickupDate                DateTime?                  @map("pickup_date")
  pieces                    Int
  weightKg                  Decimal                    @map("weight_kg") @db.Decimal(10, 2)
  dimensionsJson            Json                       @map("dimensions_json")
  commercialValue           Decimal?                   @map("commercial_value") @db.Decimal(12, 2)
  incoterms                 String?
  dangerousGoods            Boolean                    @default(false) @map("dangerous_goods")
  unNumber                  String?                    @map("un_number")
  dangerousGoodsClass       String?                    @map("dangerous_goods_class")
  specialInstructions       String?                    @map("special_instructions") @db.Text
  suggestedServices         Json?                      @map("suggested_services")
  status                    QuoteStatus                @default(PENDING_REVIEW)
  serviceCategory           ServiceCategory?           @map("service_category")
  workflowStage             QuoteWorkflowStage         @default(QUOTATION) @map("workflow_stage")
  carrierName               String?                    @map("carrier_name")
  serviceName               String?                    @map("service_name")
  customerCarrierPreference String?                    @map("customer_carrier_preference")
  currency                  String?                    @default("EUR")
  isCommercial              Boolean?                   @map("is_commercial")
  goodsDescription          String?                    @map("goods_description") @db.Text
  originCountry             String?                    @map("origin_country")
  originCity                String?                    @map("origin_city")
  originPostalCode          String?                    @map("origin_postal_code")
  destCountry               String?                    @map("dest_country")
  destCity                  String?                    @map("dest_city")
  destPostalCode            String?                    @map("dest_postal_code")
  bookingJson               Json?                      @map("booking_json")
  bookingSubmittedAt        DateTime?                  @map("booking_submitted_at")
  bookingImpact             String?                    @map("booking_impact")
  bookingChangesJson        Json?                      @map("booking_changes_json")
  draftJson                 Json?                      @map("draft_json")
  aiConversationJson        Json?                      @map("ai_conversation_json")
  submissionToken           String?                    @map("submission_token")
  isDraft                   Boolean                    @default(false) @map("is_draft")
  needsReapproval           Boolean                    @default(false) @map("needs_reapproval")
  requestSource             String?                    @map("request_source")
  internalRequestNotes      String?                    @map("internal_request_notes") @db.Text
  createdByAdminId          String?                    @map("created_by_admin_id")
  isGuest                   Boolean                    @default(false) @map("is_guest")
  guestName                 String?                    @map("guest_name")
  guestCompany              String?                    @map("guest_company")
  guestPhone                String?                    @map("guest_phone")
  guestEmail                String?                    @map("guest_email")
  linkedToCustomerAt        DateTime?                  @map("linked_to_customer_at")
  linkedByAdminId           String?                    @map("linked_by_admin_id")
  acceptedOnBehalf          Boolean                    @default(false) @map("accepted_on_behalf")
  acceptedByAdminId         String?                    @map("accepted_by_admin_id")
  acceptedOnBehalfAt        DateTime?                  @map("accepted_on_behalf_at")
  acceptanceSource          String?                    @map("acceptance_source")
  acceptanceReference       String?                    @map("acceptance_reference")
  acceptanceNote            String?                    @map("acceptance_note") @db.Text
  createdAt                 DateTime                   @default(now()) @map("created_at")
  updatedAt                 DateTime                   @updatedAt @map("updated_at")
  files                     QuoteFile[]
  shipment                  Shipment?
  adminQuotations           AdminQuotation[]
  shipmentPieces            ShipmentPiece[]
  calculation               QuoteCalculation?
  bookingChecklist          BookingChecklist?
  validationWarnings        PackageValidationWarning[]
  overrides                 PricingOverride[]
  quoteOptions              QuoteOption[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([organizationId])
  @@index([submissionToken])
  @@map("quotes")
}

model QuoteFile {
  id               String   @id @default(cuid())
  quoteId          String   @map("quote_id")
  quote            Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  fileType         String   @map("file_type")
  fileName         String   @map("file_name")
  cloudStoragePath String   @map("cloud_storage_path")
  contentType      String   @map("content_type")
  isPublic         Boolean  @default(false) @map("is_public")
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([quoteId])
  @@map("quote_files")
}

model Shipment {
  id                       String               @id @default(cuid())
  quoteId                  String               @unique @map("quote_id")
  quote                    Quote                @relation(fields: [quoteId], references: [id])
  userId                   String               @map("user_id")
  user                     User                 @relation(fields: [userId], references: [id])
  reference                String?              @unique @map("reference")
  trackingNumber           String               @unique @map("tracking_number")
  awbNumber                String?              @map("awb_number")
  carrier                  String
  customerServiceName      String?              @map("customer_service_name")
  sellingPrice             Decimal?             @map("selling_price") @db.Decimal(12, 2)
  sellingCurrency          String?              @map("selling_currency")
  operationalNotes         String?              @map("operational_notes") @db.Text
  status                   ShipmentStatus       @default(BOOKED)
  origin                   String
  destination              String
  estimatedDelivery        DateTime?            @map("estimated_delivery")
  customsSubStatus         String?              @map("customs_sub_status")
  actionRequired           Boolean              @default(false) @map("action_required")
  actionType               String?              @map("action_type")
  actionMessage            String?              @map("action_message") @db.Text
  podPath                  String?              @map("pod_path")
  bookedWeightKg           Decimal?             @map("booked_weight_kg") @db.Decimal(10, 2)
  bookedPieceCount         Int?                 @map("booked_piece_count")
  bookedService            String?              @map("booked_service")
  actualPieceCount         Int?                 @map("actual_piece_count")
  actualWeightKg           Decimal?             @map("actual_weight_kg") @db.Decimal(10, 2)
  actualChargeableWeightKg Decimal?             @map("actual_chargeable_weight_kg") @db.Decimal(10, 2)
  actualDimensions         String?              @map("actual_dimensions")
  actualCarrierService     String?              @map("actual_carrier_service")
  actualCarrierReference   String?              @map("actual_carrier_reference")
  actualPickupAt           DateTime?            @map("actual_pickup_at")
  actualDeliveryAt         DateTime?            @map("actual_delivery_at")
  actualCustomsOutcome     String?              @map("actual_customs_outcome")
  actualCarrierCost        Decimal?             @map("actual_carrier_cost") @db.Decimal(12, 2)
  actualCurrency           String?              @map("actual_currency")
  createdAt                DateTime             @default(now()) @map("created_at")
  updatedAt                DateTime             @updatedAt @map("updated_at")
  trackingEvents           TrackingEvent[]
  amendments               ShipmentAmendment[]
  adjustments              ShipmentAdjustment[]
  documents                ShipmentDocument[]
  invoices                 Invoice[]

  @@index([userId, status])
  @@index([status, updatedAt])
  @@map("shipments")
}

model ShipmentDocument {
  id                String   @id @default(cuid())
  shipmentId        String   @map("shipment_id")
  shipment          Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  category          String   @map("category")
  fileName          String   @map("file_name")
  cloudStoragePath  String   @map("cloud_storage_path")
  contentType       String   @map("content_type")
  sizeBytes         Int?     @map("size_bytes")
  isCustomerVisible Boolean  @default(false) @map("is_customer_visible")
  uploadedById      String?  @map("uploaded_by_id")
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([shipmentId])
  @@map("shipment_documents")
}

model Invoice {
  id           String    @id @default(cuid())
  reference    String    @unique @map("reference")
  shipmentId   String    @map("shipment_id")
  shipment     Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  userId       String    @map("user_id")
  user         User      @relation(fields: [userId], references: [id])
  customerName String?   @map("customer_name")
  customerEmail String?  @map("customer_email")
  serviceName  String?   @map("service_name")
  sellingPrice Decimal   @map("selling_price") @db.Decimal(12, 2)
  currency     String    @default("EUR")
  chargesJson  Json?     @map("charges_json")
  subtotal     Decimal   @db.Decimal(12, 2)
  vatPct       Decimal?  @map("vat_pct") @db.Decimal(5, 2)
  vatAmount    Decimal?  @map("vat_amount") @db.Decimal(12, 2)
  total        Decimal   @db.Decimal(12, 2)
  paymentTerms String?   @map("payment_terms")
  dueDate      DateTime? @map("due_date")
  status       String    @default("DRAFT")
  notes        String?   @db.Text
  createdById  String?   @map("created_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  finalizedAt  DateTime? @map("finalized_at")

  @@index([shipmentId])
  @@index([userId, status])
  @@map("invoices")
}

model TrackingEvent {
  id                  String         @id @default(cuid())
  shipmentId          String         @map("shipment_id")
  shipment            Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  status              ShipmentStatus
  location            String
  description         String
  country             String?        @map("country")
  customerDescription String?        @map("customer_description") @db.Text
  internalDescription String?        @map("internal_description") @db.Text
  carrierStatusCode   String?        @map("carrier_status_code")
  source              String         @default("MANUAL") @map("source")
  actionRequired      Boolean        @default(false) @map("action_required")
  timestamp           DateTime       @default(now())

  @@index([shipmentId, timestamp])
  @@map("tracking_events")
}

model ShipmentAmendment {
  id            String   @id @default(cuid())
  shipmentId    String   @map("shipment_id")
  shipment      Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  amendmentType String   @map("amendment_type")
  phase         String   @map("phase")
  impact        String   @default("NO_PRICE_IMPACT")
  changesJson   Json?    @map("changes_json")
  reason        String?  @db.Text
  createdBy     String?  @map("created_by")
  createdByRole String?  @map("created_by_role")
  status        String   @default("APPLIED")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([shipmentId, createdAt])
  @@map("shipment_amendments")
}

model ShipmentAdjustment {
  id                        String    @id @default(cuid())
  shipmentId                String    @map("shipment_id")
  shipment                  Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  adjustmentType            String    @map("adjustment_type")
  description               String?   @db.Text
  customerReason            String?   @map("customer_reason") @db.Text
  carrierCostAdjustment     Decimal   @default(0) @map("carrier_cost_adjustment") @db.Decimal(12, 2)
  customerSellingAdjustment Decimal   @default(0) @map("customer_selling_adjustment") @db.Decimal(12, 2)
  currency                  String    @default("EUR")
  status                    String    @default("DRAFT")
  requiresCustomerApproval  Boolean   @default(false) @map("requires_customer_approval")
  customerApprovalStatus    String?   @map("customer_approval_status")
  createdBy                 String?   @map("created_by")
  createdAt                 DateTime  @default(now()) @map("created_at")
  decidedAt                 DateTime? @map("decided_at")

  @@index([shipmentId, createdAt])
  @@map("shipment_adjustments")
}

model AdminQuotation {
  id                   String          @id @default(cuid())
  quoteId              String          @map("quote_id")
  quote                Quote           @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  versionNumber        Int             @default(1) @map("version_number")
  isCurrent            Boolean         @default(true) @map("is_current")
  revisionReason       String?         @map("revision_reason") @db.Text
  acceptedAt           DateTime?       @map("accepted_at")
  rejectedAt           DateTime?       @map("rejected_at")
  validUntil           DateTime?       @map("valid_until")
  internalNotes        String?         @map("internal_notes") @db.Text
  includedServices     String?         @map("included_services") @db.Text
  excludedServices     String?         @map("excluded_services") @db.Text
  createdBy            String?         @map("created_by")
  carrierSelected      String          @map("carrier_selected")
  serviceSelected      String?         @map("service_selected")
  overrideReason       String?         @map("override_reason") @db.Text
  carrierCost          Decimal         @default(0) @map("carrier_cost") @db.Decimal(12, 2)
  pickupFee            Decimal         @default(0) @map("pickup_fee") @db.Decimal(12, 2)
  deliveryFee          Decimal         @default(0) @map("delivery_fee") @db.Decimal(12, 2)
  fuelSurcharge        Decimal         @default(0) @map("fuel_surcharge") @db.Decimal(6, 2)
  insuranceFee         Decimal         @default(0) @map("insurance_fee") @db.Decimal(12, 2)
  dgFee                Decimal         @default(0) @map("dg_fee") @db.Decimal(12, 2)
  documentationFee     Decimal         @default(0) @map("documentation_fee") @db.Decimal(12, 2)
  customsFee           Decimal         @default(0) @map("customs_fee") @db.Decimal(12, 2)
  remoteAreaFee        Decimal         @default(0) @map("remote_area_fee") @db.Decimal(12, 2)
  otherCharges         Decimal         @default(0) @map("other_charges") @db.Decimal(12, 2)
  discountPct          Decimal         @default(0) @map("discount_pct") @db.Decimal(6, 2)
  discountAmount       Decimal         @default(0) @map("discount_amount") @db.Decimal(12, 2)
  markupPct            Decimal         @default(0) @map("markup_pct") @db.Decimal(6, 2)
  markupAmount         Decimal         @default(0) @map("markup_amount") @db.Decimal(12, 2)
  vatPct               Decimal         @default(0) @map("vat_pct") @db.Decimal(6, 2)
  vatAmount            Decimal         @default(0) @map("vat_amount") @db.Decimal(12, 2)
  subtotal             Decimal         @default(0) @db.Decimal(12, 2)
  finalPrice           Decimal         @default(0) @map("final_price") @db.Decimal(12, 2)
  currency             String          @default("EUR")
  notes                String?         @db.Text
  finalTransitTime     String?         @map("final_transit_time")
  finalTariffVersionId String?         @map("final_tariff_version_id")
  decidedBy            String?         @map("decided_by")
  decidedAt            DateTime?       @map("decided_at")
  decisionJson         Json?           @map("decision_json")
  approvedBy           String?         @map("approved_by")
  approver             User?           @relation("QuotationApprover", fields: [approvedBy], references: [id])
  approvedAt           DateTime?       @map("approved_at")
  sentAt               DateTime?       @map("sent_at")
  status               QuotationStatus @default(DRAFT)
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")
  options              QuoteOption[]

  @@unique([quoteId, versionNumber])
  @@index([status, updatedAt])
  @@index([quoteId, isCurrent])
  @@map("admin_quotations")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  message   String
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

model SupportTicket {
  id        String       @id @default(cuid())
  userId    String       @map("user_id")
  user      User         @relation(fields: [userId], references: [id])
  subject   String
  message   String       @db.Text
  response  String?      @db.Text
  status    TicketStatus @default(OPEN)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("support_tickets")
}

model BusinessPricingProfile {
  id                String   @id @default(cuid())
  userId            String   @unique @map("user_id")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferredCarrier  String?  @map("preferred_carrier")
  preferredService  String?  @map("preferred_service")
  preferredCurrency String   @default("EUR") @map("preferred_currency")
  discountPct       Decimal  @default(0) @map("discount_pct") @db.Decimal(6, 2)
  creditDays        Int      @default(0) @map("credit_days")
  creditLimit       Decimal  @default(0) @map("credit_limit") @db.Decimal(12, 2)
  paymentTerms      String?  @map("payment_terms")
  specialNotes      String?  @map("special_notes") @db.Text
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("business_pricing_profiles")
}

model PriceMatrix {
  id            String      @id @default(cuid())
  name          String
  originCountry String      @map("origin_country")
  destCountry   String      @map("dest_country")
  zone          String?
  serviceType   ServiceType @map("service_type")
  weightFrom    Decimal     @default(0) @map("weight_from") @db.Decimal(10, 2)
  weightTo      Decimal     @default(0) @map("weight_to") @db.Decimal(10, 2)
  ratePerKg     Decimal     @default(0) @map("rate_per_kg") @db.Decimal(12, 2)
  minCharge     Decimal     @default(0) @map("min_charge") @db.Decimal(12, 2)
  currency      String      @default("EUR")
  transitDays   String?     @map("transit_days")
  notes         String?     @db.Text
  isActive      Boolean     @default(true) @map("is_active")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@index([originCountry, destCountry, serviceType, isActive])
  @@map("price_matrices")
}

model QuotationTemplate {
  id               String      @id @default(cuid())
  name             String
  carrier          String
  serviceType      ServiceType @map("service_type")
  fuelSurcharge    Decimal     @default(0) @map("fuel_surcharge") @db.Decimal(6, 2)
