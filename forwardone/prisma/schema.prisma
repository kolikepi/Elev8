// ============================================================
// PHASE 2.5 — GLOBAL LOCATION MASTER DATA (additive)
// Kept intentionally SEPARATE from carrier-specific zone/tariff
// tables (CountryZoneMapping, PostalCodeZone). This is the
// shared, module-agnostic source of truth for locations.
// ============================================================

model Country {
  id          String   @id @default(cuid())
  name        String   @unique
  iso2        String   @unique
  iso3        String?  @unique
  callingCode String?  @map("calling_code")
  currency    String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  regions     Region[]
  cities      City[]
  postalCodes PostalCode[]

  @@index([isActive])
  @@map("countries")
}

model Region {
  id        String   @id @default(cuid())
  countryId String   @map("country_id")
  country   Country  @relation(fields: [countryId], references: [id], onDelete: Restrict)
  name      String
  code      String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cities    City[]

  @@unique([countryId, name])
  @@index([countryId])
  @@index([isActive])
  @@map("regions")
}

model City {
  id        String   @id @default(cuid())
  countryId String   @map("country_id")
  country   Country  @relation(fields: [countryId], references: [id], onDelete: Restrict)
  regionId  String?  @map("region_id")
  region    Region?  @relation(fields: [regionId], references: [id], onDelete: SetNull)
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  postalCodes PostalCode[]

  @@index([countryId])
  @@index([regionId])
  @@index([countryId, name])
  @@index([isActive])
  @@map("cities")
}

model PostalCode {
  id        String   @id @default(cuid())
  countryId String   @map("country_id")
  country   Country  @relation(fields: [countryId], references: [id], onDelete: Restrict)
  cityId    String?  @map("city_id")
  city      City?    @relation(fields: [cityId], references: [id], onDelete: SetNull)
  code      String
  placeName String?  @map("place_name")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([countryId])
  @@index([cityId])
  @@index([countryId, code])
  @@index([isActive])
  @@map("postal_codes")
}

model PackageType {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("package_types")
}

model Currency {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  symbol    String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("currencies")
}
