# ForwardOne — required environment variables.
# Copy to .env and fill in. Never commit the real .env.

# --- Database -------------------------------------------------------------
# While still on Abacus this pointed at db-*.hosteddb.reai.io. After the
# migration, point it at your own Postgres (Neon, RDS, self-hosted).
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# --- Auth (next-auth) -----------------------------------------------------
# Generate a fresh one: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# --- File storage ---------------------------------------------------------
# On Abacus these pointed at Abacus's shared bucket, authenticated through
# AWS_PROFILE=hosted (a profile that only exists inside Abacus's runtime).
# On your own infrastructure: your bucket, your IAM user, explicit keys.
# NOTE: on Vercel, do NOT name these AWS_REGION / AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY — those are reserved on the Lambda runtime and get
# overwritten at request time. Use the S3_* names and pass them to S3Client
# explicitly (this is the bug that broke uploads on the Elev8 app).
AWS_BUCKET_NAME=
AWS_FOLDER_PREFIX=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Email ----------------------------------------------------------------
# Currently lib/email.ts posts to apps.abacus.ai/api/sendNotificationEmail
# using ABACUSAI_API_KEY + WEB_APP_ID + the NOTIF_ID_* template ids below.
# Replace with your own provider (Elev8 uses Resend) — see MIGRATION.md.
ABACUSAI_API_KEY=
WEB_APP_ID=
NOTIF_ID_QUOTE_RECEIVED=
NOTIF_ID_QUOTE_READY=
NOTIF_ID_QUOTE_ACCEPTED=
NOTIF_ID_SHIPMENT_BOOKED=
NOTIF_ID_SHIPMENT_DELIVERED=

# After migrating email to Resend:
# RESEND_API_KEY=
# EMAIL_FROM="ForwardOne <noreply@yourdomain>"
