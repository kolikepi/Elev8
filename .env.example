# Copy this file to .env and fill in real values. Never commit .env.
#
# NOTE: this project was originally built on Abacus.AI (abacus.ai). The
# variables below marked "ABACUS-HOSTED" point at infrastructure Abacus
# provisioned for you (database, file storage, transactional email). To be
# fully independent of Abacus, replace each with your own provider before
# going live. See MIGRATION.md for the step-by-step plan.

# --- Database (ABACUS-HOSTED — replace with your own Postgres) ---
# e.g. from Neon, Supabase, Railway, or your own RDS/Postgres instance
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# --- Auth (NextAuth) ---
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# --- File storage (ABACUS-HOSTED S3 bucket — replace with your own bucket) ---
# The app uses the default AWS SDK credential chain (no keys read directly
# from env by the app code) — on Abacus this resolved via an instance
# profile. Outside Abacus you must provide real credentials, e.g. via
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY, or a configured ~/.aws profile.
AWS_REGION="us-east-1"
AWS_BUCKET_NAME="your-own-bucket-name"
AWS_FOLDER_PREFIX=""
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""

# --- Seeding (optional) ---
# scripts/seed.ts no longer hardcodes admin/test passwords. Set these before
# running `yarn prisma db seed` if you want fixed passwords; otherwise a
# random one is generated and printed once to the console.
# SEED_ADMIN_PASSWORD=""
# SEED_TEST_PASSWORD=""

# --- Transactional email (now sent via Resend — your own account) ---
# Create a free account at resend.com, verify a sending domain (or use
# their onboarding@resend.dev sandbox address while testing), and put the
# API key here. EMAIL_FROM must be an address on a domain verified in Resend.
RESEND_API_KEY=""
EMAIL_FROM="noreply@elev8wear.al"
